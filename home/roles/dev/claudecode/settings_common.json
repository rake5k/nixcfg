{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(git:*)",
      "Bash(glab ci:*)",
      "Bash(glab issue create:*)",
      "Bash(glab issue list:*)",
      "Bash(glab issue reopen:*)",
      "Bash(glab issue update:*)",
      "Bash(glab issue view:*)",
      "Bash(glab mr approvers:*)",
      "Bash(glab mr checkout:*)",
      "Bash(glab mr create:*)",
      "Bash(glab mr diff:*)",
      "Bash(glab mr for:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr note:*)",
      "Bash(glab mr rebase:*)",
      "Bash(glab mr todo:*)",
      "Bash(glab mr update:*)",
      "Bash(glab mr view:*)",
      "Bash(glab release create:*)",
      "Bash(glab release download:*)",
      "Bash(glab release list:*)",
      "Bash(glab release view:*)",
      "Bash(glab repo view:*)",
      "Bash(helm dependency update:*)",
      "Bash(helm template:*)",
      "Bash(journalctl *)",
      "Bash(loginctl list-sessions *)",
      "Bash(loginctl show-session *)",
      "Bash(ls:*)",
      "Bash(nix build *)",
      "Bash(nix develop:*)",
      "Bash(nix eval:*)",
      "Bash(nix flake:*)",
      "Bash(nix fmt:*)",
      "Bash(nix search *)",
      "Bash(nix-instantiate --eval --expr *)",
      "Bash(nix-instantiate --eval --file *)",
      "Bash(nixos-version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(systemctl status *)",
      "Bash(systemctl cat *)",
      "Edit(~/Documents/notes/claude/pages/**)",
      "Read(~/Documents/notes/claude/**)",
      "Read(~/code/flake-commons/**)",
      "Read(~/code/nixcfg-home/**)",
      "Read(~/code/nixcfg-work/**)",
      "Read(~/code/nixcfg/**)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:digicomp.ch)",
      "WebFetch(domain:docs.gitlab.com)",
      "WebFetch(domain:docs.ollama.com)",
      "WebFetch(domain:docs.sonarsource.com)",
      "WebFetch(domain:dzone.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:guides.micronaut.io)",
      "WebFetch(domain:javadoc.io)",
      "WebFetch(domain:mvnrepository.com)",
      "WebFetch(domain:nix-community.github.io)",
      "WebFetch(domain:nix.dev)",
      "WebFetch(domain:nixos.org)",
      "WebFetch(domain:numtide.github.io)",
      "WebFetch(domain:openapi-generator.tech)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:search.nixos.org)",
      "WebFetch(domain:spring.io)",
      "WebFetch(domain:springdoc.org)",
      "WebFetch(domain:tecnovy.com)",
      "WebFetch(domain:www.isaqb.org)",
      "WebSearch",
      "mcp__codegraph__*",
      "mcp__ide__getDiagnostics",
      "mcp__mcp-atlassian__confluence_get_page",
      "mcp__mcp-atlassian__confluence_get_page_children",
      "mcp__mcp-atlassian__jira_get_issue"
    ],
    "deny": [
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Edit(~/.age)",
      "Edit(~/.age/**)",
      "Read(./.env.*)",
      "Read(/etc/ssh)",
      "Read(/etc/ssh/id_!(*.pub)",
      "Read(/run/agenix)",
      "Read(/run/agenix.d)",
      "Read(/run/agenix.d/**)",
      "Read(/run/agenix/**)",
      "Read(~/.age)",
      "Read(~/.age/**)",
      "Read(~/.local/share/secrets)",
      "Read(~/.local/share/secrets/**)",
      "Read(~/.ssh)",
      "Read(~/.ssh/id_!(*.pub)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(git push *)",
      "Bash(glab mr approve:*)",
      "Bash(glab mr close:*)",
      "Bash(glab mr delete:*)",
      "Bash(glab mr reopen:*)",
      "Bash(glab mr revoke:*)",
      "Bash(glab mr subscribe:*)",
      "Bash(glab mr unsubscribe:*)",
      "Bash(glab release upload:*)",
      "Bash(nix-store --delete:*)",
      "Bash(wget:*)",
      "Read(/etc/ssh/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "honey@greenpt": true,
    "mattpocock-skills@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "greenpt": {
      "source": {
        "source": "github",
        "repo": "Green-PT/honey-for-devs"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/wiki-index.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "strictAllowlist": true,
      "allowAllUnixSockets": true,
      "allowedDomains": [
        "*.crates.io",
        "*.github.com",
        "*.npmjs.org",
        "codeload.github.com",
        "gitlab.com",
        "objects.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.cargo",
        "~/.gradle",
        "~/.m2",
        "~/.npm",
        "~/go/pkg"
      ],
      "denyRead": ["/run/docker.sock", "/var/run/docker.sock", "~/**/*.kdbx"]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.age/key.txt",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITLAB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "model": "opus[1m]",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.29"
  }
}
